# RiskWren in a container: the server, run as a user of its own, with its data home on a volume.
#
#   podman build -t riskwren -f deploy/Containerfile .        (or docker build)
#   podman run -p 127.0.0.1:8020:8020 -v riskwren-data:/data riskwren
#
# The first start sets the installation up (`riskwren init`); give the first administrator's
# address in RISKWREN_ADMIN_EMAIL and their password in RISKWREN_ADMIN_PASSWORD, or add one
# afterwards with `riskwren users add`. See docs/deployment.md.

FROM docker.io/library/python:3.13-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/riskwren
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY src ./src
RUN uv sync --frozen --no-dev --extra postgres --no-editable

FROM docker.io/library/python:3.13-slim
RUN useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin riskwren \
    && mkdir -p /data /etc/riskwren && chown riskwren /data
COPY --from=build /opt/riskwren /opt/riskwren
COPY deploy/container-start.sh /usr/local/bin/riskwren-start
ENV PATH=/opt/riskwren/bin:$PATH \
    RISKWREN_CONFIG=/data/riskwren.toml \
    RISKWREN_DATA_HOME=/data/var \
    RISKWREN_SERVER_HOST=0.0.0.0 \
    RISKWREN_SERVER_PORT=8020 \
    PYTHONUNBUFFERED=1
USER riskwren
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8020
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8020/api/v1/health/ready', timeout=4).status == 200 else 1)"
ENTRYPOINT ["riskwren-start"]
CMD ["riskwren", "serve"]
