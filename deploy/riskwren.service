# RiskWren as a systemd service, locked down. See docs/deployment.md.
#
#   sudo useradd --system --home-dir /var/lib/riskwren --shell /usr/sbin/nologin riskwren
#   sudo install -d -o riskwren -g riskwren -m 0750 /var/lib/riskwren /etc/riskwren
#   (install RiskWren into /opt/riskwren, write /etc/riskwren/riskwren.toml with
#    home = "/var/lib/riskwren/var", and put secrets in /etc/riskwren/env, mode 0600)
#   sudo cp deploy/riskwren.service /etc/systemd/system/ && sudo systemctl enable --now riskwren

[Unit]
Description=RiskWren, a system of record for governance, risk, and compliance
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=riskwren
Group=riskwren
Environment=RISKWREN_CONFIG=/etc/riskwren/riskwren.toml
EnvironmentFile=-/etc/riskwren/env
ExecStartPre=/opt/riskwren/bin/riskwren db upgrade
ExecStart=/opt/riskwren/bin/riskwren serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Only the data home is writable; everything else is read-only or hidden.
ReadWritePaths=/var/lib/riskwren
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target
