# Copy to deploy/.env, fill in, and keep it out of version control.
RISKWREN_BASE_URL=https://grc.example.org
RISKWREN_DB_PASSWORD=
RISKWREN_WORKERS=4
# The first administrator, made on the first start only. Remove the password once they can sign in.
RISKWREN_ADMIN_EMAIL=
RISKWREN_ADMIN_NAME=
RISKWREN_ADMIN_PASSWORD=
# research-institute (the default), academic-medical-center, university, or nonprofit
RISKWREN_PROGRAM=
